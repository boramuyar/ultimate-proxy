# Copy to .env and change these before exposing the stack beyond your machine.

# Break-glass admin token. Leave it empty (PROXY_ADMIN_TOKEN=) to turn it off
# once single sign-on works.
PROXY_ADMIN_TOKEN=dev-admin-token
DEMO_APP_KEY=up_demo_key
POSTGRES_PASSWORD=postgres
CLICKHOUSE_PASSWORD=clickhouse

# Optional: a real OpenAI key, for /openai/v1/... (any OpenAI model).
OPENAI_API_KEY=

# Dashboard sign-in with your own OpenID Connect provider (Google, Entra ID,
# Okta, Auth0, Keycloak, Authentik, ...). Register this app with it, using
# OIDC_REDIRECT_URL as the redirect URI. Off while OIDC_ISSUER is empty.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:3000/admin/auth/callback
OIDC_DISPLAY_NAME=
# Who may sign in as an admin (comma-separated; anyone matching any list).
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_DOMAINS=
OIDC_ALLOWED_GROUPS=
# Who may sign in read-only. Set at least one admin or viewer list.
OIDC_VIEWER_EMAILS=
OIDC_VIEWER_DOMAINS=
OIDC_VIEWER_GROUPS=
# Optional: extra scopes (default "openid email profile") and the claim with
# the user's groups (default "groups").
OIDC_SCOPES=
OIDC_GROUPS_CLAIM=
# Signs session cookies; keep sessions across restarts. Make one with
# `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=

# Optional: send a trace span per model call to an OpenTelemetry collector
# over OTLP/HTTP, such as http://otel-collector:4318. Spans hold metadata,
# never prompts or outputs. TRACING_AUTHORIZATION is sent as the
# Authorization header, for backends that need a key.
TRACING_ENDPOINT=
TRACING_AUTHORIZATION=

# Optional: your own Valkey, Redis 7+ or Dragonfly for rate limit counters,
# instead of the bundled Valkey. Set both lines; the second stops compose from
# starting the bundled one. Use host.docker.internal for a server on this
# machine.
# REDIS_URL=redis://:password@redis.internal:6379/0
# COMPOSE_FILE=docker-compose.yml:deploy/compose/external-redis.yml

# Host ports.
PROXY_PORT=8080
DASHBOARD_PORT=3000
