# Copy to .env and change these before exposing the stack beyond your machine.

# Break-glass admin token. Leave it empty (PROXY_ADMIN_TOKEN=) to turn it off
# once single sign-on works.
PROXY_ADMIN_TOKEN=dev-admin-token
DEMO_APP_KEY=up_demo_key
POSTGRES_PASSWORD=postgres
CLICKHOUSE_PASSWORD=clickhouse

# Optional: a real OpenAI key, for /openai/v1/... (any OpenAI model).
OPENAI_API_KEY=

# Dashboard sign-in with your own OpenID Connect provider (Google, Entra ID,
# Okta, Auth0, Keycloak, Authentik, ...). Register this app with it, using
# OIDC_REDIRECT_URL as the redirect URI. Off while OIDC_ISSUER is empty.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:3000/admin/auth/callback
OIDC_DISPLAY_NAME=
# Who may sign in (comma-separated; anyone matching any list). Set at least one.
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_DOMAINS=
OIDC_ALLOWED_GROUPS=
# Optional: extra scopes (default "openid email profile") and the claim with
# the user's groups (default "groups").
OIDC_SCOPES=
OIDC_GROUPS_CLAIM=
# Signs session cookies; keep sessions across restarts. Make one with
# `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=

# Host ports.
PROXY_PORT=8080
DASHBOARD_PORT=3000
