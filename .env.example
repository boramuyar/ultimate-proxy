# Copy to .env and change these before exposing the stack beyond your machine.
PROXY_ADMIN_TOKEN=dev-admin-token
DEMO_APP_KEY=up_demo_key
POSTGRES_PASSWORD=postgres

# Optional: a real provider key for the "smart" and "fast" models.
OPENAI_API_KEY=

# Host ports.
PROXY_PORT=8080
DASHBOARD_PORT=3000
